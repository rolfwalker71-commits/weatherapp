# Optional override. Empty = SPA talks to /api/push (Vite proxy / nginx).
# If the companion API is down, the UI shows «Push-Server nicht konfiguriert»
# and still stores notification categories in localStorage.
PUBLIC_PUSH_API_URL=

# Companion API (push-api). Generate with:
#   npx web-push generate-vapid-keys
# Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:weather@localhost

# Real Web Push delivery (kill switch). Off by default.
# 1. Put VAPID keys in the environment (never commit the private key).
# 2. docker compose -f docker-compose.yml -f docker-compose.push.yml up -d
# 3. PUSH_SEND_ENABLED=true
# The worker then evaluates Regen bald / Warnungen / Frost / UV / Luft / Morgenbriefing
# against the stored place and sends via web-push, with a few hours cooldown per category.
PUSH_SEND_ENABLED=false

# Optional. Required for POST /v1/send and /v1/send-test when not calling from localhost.
#   curl -X POST http://127.0.0.1:4426/v1/send-test
#   curl -X POST https://<host>/api/push/v1/send-test -H "X-Push-Test-Token: $PUSH_TEST_TOKEN"
PUSH_TEST_TOKEN=

# Worker interval in ms (default 600000 = 10 min).
PUSH_POLL_MS=600000
