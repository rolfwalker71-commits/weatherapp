# Optional override. Empty = SPA talks to same-origin /api/push (in-image Node).
PUBLIC_PUSH_API_URL=

# VAPID keys are generated on first start and stored in SQLite (/data/push.db).
# Optional restore: set BOTH keys to override the database pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:weather@localhost

# Kill switch. Default is on once keys exist.
# PUSH_SEND_ENABLED=false
PUSH_SEND_ENABLED=true

# Optional. Required for POST /api/push/v1/send and /v1/send-test when not calling from localhost.
#   curl -X POST http://127.0.0.1:4425/api/push/v1/send-test
#   curl -X POST https://<host>/api/push/v1/send-test -H "X-Push-Test-Token: $PUSH_TEST_TOKEN"
PUSH_TEST_TOKEN=

# Worker interval in ms (default 600000 = 10 min).
PUSH_POLL_MS=600000

# Native iOS app (Apple Push Notification service). Needs an Apple Developer account:
# Certificates, Identifiers & Profiles → Keys → new key with "Apple Push Notifications service".
# docker-compose.yml mounts ./apns read-only at /run/apns; save the key as ./apns/AuthKey.p8.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=9XZWUZ7Z26
# Alternatively the .p8 content (newlines as \n) or another path inside the container:
# APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_KEY_FILE=/run/apns/AuthKey.p8
# APNS_BUNDLE_ID=ch.rolfwalker.wetter
# Local development only: deliver into the booted iOS Simulator via `xcrun simctl push`.
# APNS_TRANSPORT=simctl
