{
	"name": "weatherapp",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"push:dev": "npm --prefix push-api start",
		"ios:sync": "vite build && cap sync ios",
		"ios:open": "cap open ios",
		"ios:dev": "PUBLIC_PUSH_API_URL=http://localhost:4426 vite build && cap sync ios"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24.10.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.4.23",
		"postcss": "^8.5.6",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"vite-plugin-pwa": "^1.2.0"
	},
	"dependencies": {
		"@capacitor/core": "^8.5.2",
		"@capacitor/geolocation": "^8.2.2",
